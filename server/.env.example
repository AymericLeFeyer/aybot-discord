# Port du serveur HTTP (API + interface buildée)
PORT=3000
# Intervalle de vérification YouTube, en minutes
POLL_INTERVAL_MINUTES=5
# Fichier de stockage des abonnements (relatif au dossier server/)
DATA_FILE=./data/subscriptions.json
# Optionnel : protège l'interface et l'API par mot de passe (HTTP Basic Auth, nom d'utilisateur libre)
ADMIN_PASSWORD=
