# Variables lues par docker compose (copier en .env à côté de docker-compose.yml)

# Port exposé sur l'hôte
AYBOT_PORT=3000
# Intervalle de vérification YouTube, en minutes
POLL_INTERVAL_MINUTES=5
# Mot de passe de l'interface (HTTP Basic Auth, nom d'utilisateur libre). Vide = pas d'auth.
ADMIN_PASSWORD=
